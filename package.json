{
  "name": "cv-analyzer-light",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --outfile=dist/server.cjs --format=cjs --external:framer-motion --external:mammoth",
    "build:fe": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node18 --outfile=dist/server.cjs --format=cjs --external:framer-motion --external:mammoth",
    "start": "node dist/server.cjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^0.12.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.24.2",
    "tailwindcss": "^4.0.0-beta.8",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
