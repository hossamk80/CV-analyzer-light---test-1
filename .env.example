# AI Provider Configuration
# Set your default Gemini API key here (optional, can also be configured in the UI)
GEMINI_API_KEY=

# Server Authentication & Port
# Change AUTH_SECRET in production to a long random secret
AUTH_SECRET=demo-secret-key-change-me-in-production
PORT=3000

# App URL (optional, defaults to http://localhost:3000)
APP_URL=http://localhost:3000
