{
  "name": "Smart Recruitment Suite (CV Analyzer)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "postCreateCommand": "npm install && cp -n .env.example .env.local || true",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Smart ATS (API + web)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "remoteUser": "node"
}
